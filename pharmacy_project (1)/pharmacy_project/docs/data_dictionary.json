    "description": "Contact number, format 051-1234567."
   },
   {
    "column": "address",
    "type": "varchar(250)",
    "nullable": "NO",
    "constraints": "",
    "description": "Postal address."
   },
   {
    "column": "is_active",
    "type": "tinyint(1)",
    "nullable": "NO",
    "constraints": "DEFAULT 1",
    "description": "FALSE = no longer used for orders."
   }
  ]
 },
 {
  "table": "purchase_orders",
  "purpose": "One delivery / order placed with a supplier.",
  "rowcount": 30,
  "columns": [
   {
    "column": "po_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "supplier_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "FK -> suppliers(supplier_id)",
    "description": "Supplier the order was placed with."
   },
   {
    "column": "order_date",
    "type": "date",
    "nullable": "NO",
    "constraints": "DEFAULT curdate()",
    "description": "Date of the order / delivery."
   },
   {
    "column": "status",
    "type": "enum('Pending','Received','Cancelled')",
    "nullable": "NO",
    "constraints": "DEFAULT Pending",
    "description": "Pending, Received or Cancelled."
   },
   {
    "column": "total_cost",
    "type": "decimal(12,2)",
    "nullable": "NO",
    "constraints": "CHECK total_cost >= 0; DEFAULT 0.00",
    "description": "Sum of received_qty x cost_price of its batches (maintained by trigger)."
   }
  ]
 },
 {
  "table": "stock_batches",
  "purpose": "Stock received in a purchase order, tracked per batch with its own expiry date.",
  "rowcount": 52,
  "columns": [
   {
    "column": "batch_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "product_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "FK -> products(product_id); UNIQUE",
    "description": "Medicine in this batch."
   },
   {
    "column": "po_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "FK -> purchase_orders(po_id)",
    "description": "Purchase order that delivered it."
   },
   {
    "column": "batch_no",
    "type": "varchar(30)",
    "nullable": "NO",
    "constraints": "UNIQUE",
    "description": "Manufacturer lot number (unique per product)."
   },
   {
    "column": "received_qty",
    "type": "int(11)",
    "nullable": "NO",
    "constraints": "CHECK received_qty > 0; CHECK quantity >= 0 and quantity <= received_qty",
    "description": "Units delivered."
   },
   {
    "column": "quantity",
    "type": "int(11)",
    "nullable": "NO",
    "constraints": "CHECK quantity >= 0 and quantity <= received_qty",
    "description": "Units still on the shelf (falls as sales are made)."
   },
   {
    "column": "expiry_date",
    "type": "date",
    "nullable": "NO",
    "constraints": "",
    "description": "Last day the batch may be sold."
   },
   {
    "column": "cost_price",
    "type": "decimal(10,2)",
    "nullable": "NO",
    "constraints": "CHECK cost_price >= 0",
    "description": "Purchase price per unit in PKR."
   }
  ]
 },
 {
