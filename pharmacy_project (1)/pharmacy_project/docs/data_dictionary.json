 {
  "table": "stock_alerts",
  "purpose": "Low-stock / near-expiry / expired alerts produced by the daily event.",
  "rowcount": 0,
  "columns": [
   {
    "column": "alert_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "alert_type",
    "type": "enum('LOW_STOCK','NEAR_EXPIRY','EXPIRED')",
