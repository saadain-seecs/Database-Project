[
 {
  "table": "categories",
  "purpose": "Groups medicines into categories (analgesics, antibiotics ...).",
  "rowcount": 10,
  "columns": [
   {
    "column": "category_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "category_name",
    "type": "varchar(60)",
    "nullable": "NO",
    "constraints": "UNIQUE",
    "description": "Unique category name."
   },
   {
    "column": "description",
    "type": "varchar(200)",
    "nullable": "YES",
    "constraints": "",
    "description": "Free-text note."
   }
  ]
 },
 {
  "table": "products",
  "purpose": "Catalogue of medicines and devices sold by the pharmacy.",
  "rowcount": 41,
  "columns": [
   {
    "column": "product_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "name",
    "type": "varchar(100)",
    "nullable": "NO",
    "constraints": "UNIQUE",
    "description": "Brand / product name with strength (unique)."
   },
   {
    "column": "generic_name",
    "type": "varchar(100)",
    "nullable": "YES",
    "constraints": "",
    "description": "Active ingredient."
   },
   {
    "column": "manufacturer",
    "type": "varchar(80)",
    "nullable": "YES",
    "constraints": "",
    "description": "Added later with ALTER TABLE (DDL demo); optional."
   },
   {
    "column": "category_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "FK -> categories(category_id)",
    "description": "Category the product belongs to."
   },
   {
    "column": "unit_price",
    "type": "decimal(10,2)",
    "nullable": "NO",
    "constraints": "CHECK unit_price >= 0",
    "description": "Selling price per unit in PKR."
   },
   {
    "column": "reorder_level",
    "type": "int(11)",
    "nullable": "NO",
    "constraints": "CHECK reorder_level >= 0; DEFAULT 20",
    "description": "Re-order when sellable stock falls below this."
   },
   {
    "column": "requires_prescription",
    "type": "tinyint(1)",
    "nullable": "NO",
    "constraints": "DEFAULT 0",
    "description": "TRUE for prescription-only medicines."
   }
  ]
 },
 {
  "table": "suppliers",
  "purpose": "Wholesalers / distributors the pharmacy buys from.",
  "rowcount": 12,
  "columns": [
   {
    "column": "supplier_id",
    "type": "int(10) unsigned",
    "nullable": "NO",
    "constraints": "PK",
    "description": "Surrogate key."
   },
   {
    "column": "name",
    "type": "varchar(100)",
    "nullable": "NO",
    "constraints": "UNIQUE",
