digraph RS { graph [rankdir=LR, nodesep=0.35, ranksep=0.9, fontname="Helvetica", pad=0.3, splines=true];
node [shape=plain, fontname="Helvetica", fontsize=10]; edge [arrowhead=crow, arrowtail=tee, dir=both, color="#555555"];
audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#EDEDED"><B>audit_log</B></TD></TR><TR><TD ALIGN="LEFT" PORT="log_id"><B>log_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="table_name">table_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(40)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="record_id">record_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="action">action</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="old_value">old_value</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="new_value">new_value</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="changed_at">changed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by">changed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80)</FONT></TD><TD> </TD></TR></TABLE>>];
cashiers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#E2F0D9"><B>cashiers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><B>employee_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shift">shift</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="counter_no">counter_no</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">tinyint</FONT></TD><TD> </TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>categories</B></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><B>category_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name">category_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(60)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(200)</FONT></TD><TD> </TD></TR></TABLE>>];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><B>customer_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="registered_on">registered_on</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD> </TD></TR></TABLE>>];
employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><B>employee_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="hire_date">hire_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bool</FONT></TD><TD> </TD></TR></TABLE>>];
pharmacists [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#E2F0D9"><B>pharmacists</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><B>employee_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="license_no">license_no</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(20)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="qualification">qualification</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(60)</FONT></TD><TD> </TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>products</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="generic_name">generic_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="manufacturer">manufacturer</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(80)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="category_id">category_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="reorder_level">reorder_level</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="requires_prescription">requires_prescription</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bool</FONT></TD><TD> </TD></TR></TABLE>>];
purchase_orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>purchase_orders</B></TD></TR><TR><TD ALIGN="LEFT" PORT="po_id"><B>po_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id">supplier_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date">order_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="total_cost">total_cost</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(12,2)</FONT></TD><TD> </TD></TR></TABLE>>];
sales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>sales</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><B>sale_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id">employee_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_date">sale_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="payment_method">payment_method</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount">total_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(12,2)</FONT></TD><TD> </TD></TR></TABLE>>];
sale_allocations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#EDEDED"><B>sale_allocations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><B>sale_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id"><B>batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="cost_price">cost_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD> </TD></TR></TABLE>>];
sale_items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>sale_items</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><B>sale_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><B>product_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD> </TD></TR></TABLE>>];
stock_alerts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#EDEDED"><B>stock_alerts</B></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id"><B>alert_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_type">alert_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">enum</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">batch_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="message">message</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(255)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">datetime</FONT></TD><TD> </TD></TR></TABLE>>];
stock_batches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>stock_batches</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id"><B>batch_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_id">po_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_no">batch_no</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(30)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="received_qty">received_qty</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="expiry_date">expiry_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">date</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="cost_price">cost_price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">decimal(10,2)</FONT></TD><TD> </TD></TR></TABLE>>];
suppliers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#2F5597"><TR><TD COLSPAN="3" BGCOLOR="#DCE9F8"><B>suppliers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_id"><B>supplier_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">int</FONT></TD><TD><FONT COLOR="#C00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(100)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(15)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">varchar(250)</FONT></TD><TD> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">bool</FONT></TD><TD> </TD></TR></TABLE>>];
purchase_orders:po_id -> stock_batches:po_id;
products:product_id -> stock_batches:product_id;
products:product_id -> sale_items:product_id;
sales:sale_id -> sale_items:sale_id;
stock_batches:batch_id -> stock_alerts:batch_id;
products:product_id -> stock_alerts:product_id;
suppliers:supplier_id -> purchase_orders:supplier_id;
employees:employee_id -> pharmacists:employee_id;
customers:customer_id -> sales:customer_id;
employees:employee_id -> sales:employee_id;
categories:category_id -> products:category_id;
employees:employee_id -> cashiers:employee_id;
stock_batches:batch_id -> sale_allocations:batch_id;
sale_items:sale_id -> sale_allocations:sale_id;
sale_items:product_id -> sale_allocations:product_id;
labelloc=t; label=<<B>Relational schema (generated from the live MySQL database)</B>>;
}